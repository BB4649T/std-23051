package com.my.company.repository;

import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.data.jpa.repository.Query;
import org.springframework.stereotype.Repository;
import com.company.school.tsinjo_std21001.domain.Donation;
import java.util.List;

@Repository
public interface DonationRepository extends JpaRepository<Donation, Long> {
    
    @Query("SELECT d FROM Donation d JOIN FETCH d.donor JOIN FETCH d.payment ORDER BY d.createdAt DESC")
    List<Donation> findAllByOrderByCreatedAtDesc();
}
